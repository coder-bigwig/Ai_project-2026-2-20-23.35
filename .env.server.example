# Server deployment environment template.
# Copy this file to `.env` and replace every CHANGE_ME value before deploying.
#
# Generate strong secrets, for example:
#   openssl rand -base64 32

# Required secrets
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DEFAULT_PASSWORD=CHANGE_ME_INITIAL_PLATFORM_PASSWORD
EXPERIMENT_MANAGER_API_TOKEN=CHANGE_ME_LONG_RANDOM_JUPYTERHUB_SERVICE_TOKEN
DUMMY_PASSWORD=CHANGE_ME_STRONG_JUPYTERHUB_LOGIN_PASSWORD
JOVYAN_PASSWORD=CHANGE_ME_STRONG_CONTAINER_SUDO_PASSWORD
DEEPTUTOR_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_DEEPTUTOR_AUTH_SECRET
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# Accounts
ADMIN_ACCOUNTS=fit_admin
TEACHER_ACCOUNTS=teacher_001,teacher_002,teacher_003,teacher_004,teacher_005

# Public routing
TRAINING_HTTP_PORT=80
JUPYTERHUB_BASE_URL=/jupyter
JUPYTERHUB_PUBLIC_URL=/jupyter
GRAFANA_ROOT_URL=http://YOUR_SERVER_IP_OR_DOMAIN/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true

# Jupyter / VS Code
JUPYTER_WORKSPACE_UI=lab
ENABLE_CODE_SERVER=1
CODE_SERVER_PORT=13337

# Runtime tuning
EXPERIMENT_MANAGER_WORKERS=8
JUPYTERHUB_REQUEST_TIMEOUT_SECONDS=45
JUPYTERHUB_START_TIMEOUT_SECONDS=300
JUPYTER_START_CONCURRENCY=4
JUPYTERHUB_SPAWNER_START_TIMEOUT=300
JUPYTERHUB_SPAWNER_HTTP_TIMEOUT=300
JUPYTERHUB_IDLE_TIMEOUT_SECONDS=1800
JUPYTERHUB_CULL_EVERY_SECONDS=300

# DeepTutor
DEEPTUTOR_TOKEN_EXPIRE_HOURS=24
DEEPTUTOR_COOKIE_SECURE=false
DEEPTUTOR_CORS_ORIGINS=
DEEPTUTOR_PUBLIC_API_BASE=/deeptutor-api
DEEPTUTOR_PUBLIC_API_BASE_EXTERNAL=/deeptutor-api
DEEPTUTOR_DISABLE_SSL_VERIFY=false

# DeepTutor model defaults
DEEPTUTOR_LLM_BINDING=deepseek
DEEPTUTOR_LLM_MODEL=deepseek-chat
DEEPTUTOR_LLM_API_KEY=
DEEPTUTOR_LLM_HOST=https://api.deepseek.com
DEEPTUTOR_LLM_API_VERSION=
DEEPTUTOR_EMBEDDING_BINDING=openai
DEEPTUTOR_EMBEDDING_MODEL=text-embedding-3-large
DEEPTUTOR_EMBEDDING_API_KEY=
DEEPTUTOR_EMBEDDING_HOST=https://api.openai.com/v1
DEEPTUTOR_EMBEDDING_DIMENSION=3072
DEEPTUTOR_EMBEDDING_API_VERSION=
DEEPTUTOR_EMBEDDING_SEND_DIMENSIONS=
DEEPTUTOR_SEARCH_PROVIDER=
DEEPTUTOR_SEARCH_API_KEY=
DEEPTUTOR_SEARCH_BASE_URL=

# AI assistant optional keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
TAVILY_API_KEY=
AI_INVOCATION_LOG_SECRET=
AI_INVOCATION_LOG_URL=http://experiment-manager:8000/api/internal/ai-invocation-logs
CACHE_TTL=3600
MAX_HISTORY=10

# Local-only exposed service ports
AI_ASSISTANT_PORT=8002
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001

# Images
TRAINING_LAB_IMAGE=training-lab:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
CADVISOR_IMAGE=ghcr.io/google/cadvisor:0.55.1
GF_INSTALL_PLUGINS=grafana-piechart-panel

# Grafana users
GRAFANA_ADMIN_USER=fit_admin
GRAFANA_TEACHER_PASSWORD=CHANGE_ME_STRONG_GRAFANA_TEACHER_PASSWORD
GRAFANA_TEACHER_LOGINS=teacher_001 teacher_002 teacher_003 teacher_004 teacher_005

# Resource tiers
RESOURCE_SMALL_LABEL=小实验
RESOURCE_SMALL_CPU=1
RESOURCE_SMALL_MEMORY=2G
RESOURCE_SMALL_STORAGE=2G
RESOURCE_SMALL_MAX_USERS=20

RESOURCE_MEDIUM_LABEL=普通实验
RESOURCE_MEDIUM_CPU=1
RESOURCE_MEDIUM_MEMORY=4G
RESOURCE_MEDIUM_STORAGE=4G
RESOURCE_MEDIUM_MAX_USERS=12

RESOURCE_LARGE_LABEL=大项目
RESOURCE_LARGE_CPU=2
RESOURCE_LARGE_MEMORY=8G
RESOURCE_LARGE_STORAGE=8G
RESOURCE_LARGE_MAX_USERS=5

RESOURCE_XLARGE_LABEL=超大项目
RESOURCE_XLARGE_CPU=4
RESOURCE_XLARGE_MEMORY=16G
RESOURCE_XLARGE_STORAGE=20G
RESOURCE_XLARGE_MAX_USERS=2
